# Copia este archivo como `.env.local` para desarrollo.
# En producción estas variables se cargan como secrets del Worker:
#   npx wrangler secret put FLOW_API_KEY
#   npx wrangler secret put FLOW_SECRET_KEY
#   npx wrangler secret put RESEND_API_KEY

# ─── URL pública del sitio ──────────────────────────────────────────────
# Flow devuelve al comprador a esta URL y le manda el webhook a este dominio.
# En local, para probar pagos reales necesitas un túnel (ngrok / cloudflared).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Flow.cl ────────────────────────────────────────────────────────────
# Las obtienes en https://www.flow.cl → Configuración → Datos para integración.
FLOW_API_KEY=
FLOW_SECRET_KEY=
# "sandbox" mientras pruebas, "produccion" cuando salgas a la calle.
FLOW_ENTORNO=sandbox

# ─── Resend (emails de confirmación de pedido) ──────────────────────────
RESEND_API_KEY=
# Remitente verificado en Resend.
EMAIL_REMITENTE=hola@thelamp.cl
# Copia interna de cada pedido.
EMAIL_PEDIDOS=hola@thelab.solutions

# ─── Contacto ───────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP=56928785039
